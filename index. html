const AVAILABLE = ["walking", "sitting", "head", "standing", "jumping"];
let currentLang = "ar";
function renderSkills() {
  const grid = document.getElementById("skillsGrid");
  grid.innerHTML = "";
  SKILLS.forEach(skill => {
    const btn = document.createElement("div");
    btn.className = "skill-btn";
    btn.onclick = () => openSkill(skill.id);
    btn.innerHTML = `<span class="icon">${skill.icon}</span>${skill[currentLang]}`;
    grid.appendChild(btn);
  });
  document.getElementById("chooseSkillTitle").textContent = DATA[currentLang].chooseSkill;
}
function openSkill(id) {
  if (!AVAILABLE.includes(id)) {
    alert(DATA[currentLang].soonMsg);
    return;
  }
  const skill = SKILLS.find(s => s.id === id);
  const content = CONTENT[id][currentLang];
  const t = DATA[currentLang];
  document.getElementById("detailIcon").textContent = skill.icon;
  document.getElementById("detailTitle").textContent = skill[currentLang];
  document.getElementById("detailEn").textContent = currentLang === "ar" ? skill.en : skill.ar;
  let html = "";
  html += `<div class="section-title">${t.musclesTitle}</div>`;
  content.muscles.forEach(m => {
    html += `<div class="muscle-card">
      <div class="muscle-name">${m.name}${currentLang === "ar" ? ` <span class="en">— ${m.en}</span>` : ""}</div>
      <div style="font-size:12px;color:#555;">${m.detail}</div>
    </div>`;
  });
  html += `<div class="section-title">${t.weaknessTitle}</div>`;
  content.weaknesses.forEach(w => {
    html += `<div class="weakness">
      <div class="weakness-title">${w.title}</div>
      <div class="weakness-body">
        <strong>${t.impactLabel}</strong> ${w.impact}<br>
        <strong>${t.exerciseLabel}</strong> ${w.exercise}<br>
        <strong>${t.progressionLabel}</strong> ${w.progression}
      </div>
    </div>`;
  });
  html += `<div class="section-title">${t.exercisesTitle}</div>`;
  content.exercises.forEach(e => {
    html += `<div class="exercise">
      <div class="exercise-name">${e.name}</div>
      <div class="exercise-dose">${e.dose}</div>
    </div>`;
  });
  html += `<div class="section-title">${t.assessmentTitle}</div>`;
  html += `<div class="assessment">`;
  content.assessment.forEach(a => { html += `• ${a}<br>`; });
  html += `</div>`;
  html += `<div class="notice">${t.notice}</div>`;
  document.getElementById("detailContent").innerHTML = html;
  document.getElementById("backBtn").textContent = t.back;
  document.getElementById("skillsScreen").style.display = "none";
  document.getElementById("detailScreen").classList.add("active");
  window.scrollTo(0, 0);
}
function backToSkills() {
  document.getElementById("skillsScreen").style.display = "block";
  document.getElementById("detailScreen").classList.remove("active");
  window.scrollTo(0, 0);
}
function toggleLang() {
  currentLang = currentLang === "ar" ? "en" : "ar";
  const root = document.getElementById("htmlRoot");
  const body = document.body;
  if (currentLang === "ar") {
    root.setAttribute("lang", "ar");
    root.setAttribute("dir", "rtl");
    body.setAttribute("dir", "rtl");
  } else {
    root.setAttribute("lang", "en");
    root.setAttribute("dir", "ltr");
    body.setAttribute("dir", "ltr");
  }
  document.getElementById("appTitle").textContent = DATA[currentLang].appTitle;
  document.getElementById("appSubtitle").textContent = DATA[currentLang].appSubtitle;
  document.getElementById("langBtn").textContent = DATA[currentLang].langBtn;
  renderSkills();
}
renderSkills();
</script>
</body>
